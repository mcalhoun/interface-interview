node_modules/
dist/
# Anything carrying a credential. Listed here rather than relying on a global
# gitignore: this is a public repository, and a clone of it must protect itself
# without depending on whatever the person cloning happens to have configured.
.env
.env.*
!.env.example
.envrc
.envrc.*
.direnv/
*.pem
*.key
!packages/**/*.key.ts
*.log
.DS_Store
bun.lockb
.scratch/

# One directory per run, named by run id. Every `bun run replay` adds another,
# so day-to-day runs stay out of the tree. Ticket 18 commits a curated set of
# genuine discovery and replay runs as a deliverable; those are added with
# `git add -f`.
/evidence/
.claude/worktrees/
